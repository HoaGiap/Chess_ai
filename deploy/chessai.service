# Máy chủ Chess_ai — systemd unit.
#
# Chạy như NGƯỜI DÙNG KHÔNG QUYỀN, nhưng được cấp riêng quyền bind cổng 80
# (CAP_NET_BIND_SERVICE) — vì Azure chuyển tiếp cổng 443 của tên miền
# *.cloudapp.azure.com xuống cổng 80 của máy ảo, và cổng 80 mặc định thuộc root.
# Nhờ vậy không cần nginx, không cần chạy bằng root.
#
# Đặt file này ở /etc/systemd/system/chessai.service

[Unit]
Description=Chess_ai — cờ vua trên trình duyệt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chessai
Group=chessai
WorkingDirectory=/opt/chessai
ExecStart=/opt/chessai/.venv/bin/python -m chessai.web --host 0.0.0.0 --port 80

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# Quyền duy nhất được cấp thêm: bind cổng 80. Không có quyền khác.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Ổn định: đo thật thấy máy chủ dùng 54 MB kể cả khi 4 ván Elo 2400 tìm
# nước cùng lúc (engine tìm theo độ sâu, không có bảng bộ nhớ, nên tốn CPU
# chứ không tốn RAM). Giới hạn 700 MB là biên an toàn gấp 13: nếu có rò rỉ thì
# bị giết và khởi động lại, thay vì bị OOM-killer giết cả máy ảo.
MemoryMax=700M

# Ổn định: máy ảo B2ts v2 là CPU burstable, nghĩa là có trần CPU thấp khi
# không dùng. ReserveCPU giữ lại một chút cho hệ điều hành khi máy đang bị
# bội thụ CPU, tránh việc người chơi phải nhận độ trễ vì hệ thống bị trễ.
CPUWeight=200

Restart=always
RestartSec=3

# Ghi log ra journalctl, không ghi file để khỏi phải dọn.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
